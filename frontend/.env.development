# ==============================================================================
# FlowCare Local Development Environment Configuration
# ==============================================================================

# Local proxy forwards /api to local XAMPP backend (http://127.0.0.1/flowcare/backend/api)
VITE_API_BASE_URL=/api

# Local Development Domain
VITE_PRODUCTION_DOMAIN=localhost

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000

# Application Name
VITE_APP_NAME="FlowCare Clinic Management System (Local)"
