# ==============================================================================
# FlowCare Production Environment Configuration
# Target Domain: flowcare.great-site.net
# ==============================================================================

# Central API Base Endpoint
# Used for all REST API communication in the production build
VITE_API_BASE_URL=https://flowcare.great-site.net/api

# Production Domain Name
VITE_PRODUCTION_DOMAIN=flowcare.great-site.net

# API Request Timeout (in milliseconds - default: 15s)
VITE_API_TIMEOUT=15000

# Application Name
VITE_APP_NAME="FlowCare Clinic Management System"
